# Base de données
# PostgreSQL (via Docker)
DATABASE_URL=postgresql+asyncpg://cctp:cctp_secret@localhost:5432/cctp_db
# SQLite (alternative sans Docker)
# DATABASE_URL=sqlite+aiosqlite:///./cctp.db

POSTGRES_USER=cctp
POSTGRES_PASSWORD=cctp_secret
POSTGRES_DB=cctp_db

# Fournisseurs LLM (au moins un requis)
ANTHROPIC_API_KEY=sk-ant-...
MISTRAL_API_KEY=...

# Modèles (valeurs par défaut)
CLAUDE_MODEL=claude-sonnet-4-6
MISTRAL_MODEL=mistral-large-latest

# Fournisseur par défaut : "claude" ou "mistral"
DEFAULT_LLM_PROVIDER=mistral

# RAG
CHROMA_PERSIST_DIR=./chroma_data
EMBEDDING_MODEL=paraphrase-multilingual-MiniLM-L12-v2
RAG_N_RESULTS=5
